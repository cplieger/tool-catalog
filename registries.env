# Pinned upstream registry refs the publisher compiles from, sourced by
# scripts/publish.sh. Renovate's customManager bumps each tag+commit pair (the
# cplieger Dockerfile `digest=commit` convention), the PR automerges through the
# validate gate, and the merge fires publish.yaml's push trigger. The COMMIT is
# the tag's dereferenced commit: publish.sh fetches codeload tarballs BY COMMIT,
# so git content addressing is the integrity anchor and a moved upstream tag
# shows up as a digest-only Renovate PR.

# renovate: datasource=github-tags depName=jdx/mise digest=commit
MISE_REF=v2026.11.5
MISE_COMMIT=32c96c4d51d3abe9af0c868eda63aabe77efddb0
# renovate: datasource=github-tags depName=aquaproj/aqua-registry digest=commit
AQUA_REF=v4.583.0
AQUA_COMMIT=8f04a41600ddfd3f430ef857a0190941cc16e6c1
